# QRShield AI - Client Environment Configuration Example
# Copy this file to .env.local in frontend/ for local development.
# Never commit real API keys or secrets to version control.

# Backend API Base URL (Render service in production, localhost in development)
VITE_API_BASE_URL=http://localhost:8000


# Supabase Public Configuration (Client-safe anonymous keys only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Application Runtime Environment (development | staging | production)
VITE_APP_ENV=development
