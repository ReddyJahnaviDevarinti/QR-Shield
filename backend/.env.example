# QRShield Backend — Render & Server Environment Variables
# Copy to backend/.env for local development.
# In Render, configure these in Dashboard > Web Service > Environment Variables.

# Server Port (Render automatically sets PORT in production; default 8000 for local)
PORT=8000

# Server Bind Host (0.0.0.0 is required for Render containerized networking)
HOST=0.0.0.0

# Node Environment (production | development | test)
NODE_ENV=development

# Allowed CORS Origins (comma-separated; in production, set to your Vercel deployment URL)
ALLOWED_ORIGINS=http://localhost:5173

# Supabase Server Configuration (Requires service-role key; never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Google Gemini API Key (Optional: for natural language explanation layer; fallback used if absent)
GEMINI_API_KEY=REPLACE_ME
