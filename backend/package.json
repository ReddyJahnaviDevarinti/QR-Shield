{
  "name": "qr-shield-backend",
  "version": "1.0.0",
  "private": true,
  "description": "QRShield backend REST API service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.2",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.2.1",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vitest": "^5.0.3"
  }
}
