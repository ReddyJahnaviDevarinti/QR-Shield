# QRShield Frontend — Vercel & Client Environment Variables
# Copy to frontend/.env.local for local development.
# In Vercel, set these in Project Settings > Environment Variables.

# Backend API Base URL (Render Web Service URL in production)
VITE_API_BASE_URL=http://localhost:8000

# Supabase Public Configuration (Client-safe publishable / anon key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Application Runtime Environment (development | staging | production)
VITE_APP_ENV=development
